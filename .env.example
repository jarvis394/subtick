# Host ports for infra/compose.yml; change them (and the URLs below) if the defaults are taken.
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
DATABASE_URL=postgres://subtick:subtick@localhost:5432/subtick
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
# Origin browsers load presigned clip URLs from, when it differs from S3_ENDPOINT (production).
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=subtick
S3_SECRET_ACCESS_KEY=subtick-secret
S3_BUCKET_DEMOS=demos
S3_BUCKET_CLIPS=clips
# SeaweedFS volume server status, for disk size and free space on the admin Storage page.
S3_DISK_STATUS_URL=http://localhost:58080/status
LOG_LEVEL=INFO
LOG_FORMAT=pretty
# Public origin of the web app; the api is served under /api on the same origin.
PUBLIC_URL=http://localhost:5173
API_PORT=3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
SECRETS_KEY=
# Sends email-confirmation links (https://resend.com/api-keys); leave unset locally to log them.
# RESEND_API_KEY=
# MAIL_FROM=subtick <noreply@example.com>
STEAM_API_KEY=
# Optional Steam bot for the Game Coordinator (demo URLs + parties). Use a dedicated account.
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# Mobile authenticator shared secret, or a one-off emailed Steam Guard code for the first login.
STEAM_BOT_SHARED_SECRET=
STEAM_BOT_GUARD_CODE=
