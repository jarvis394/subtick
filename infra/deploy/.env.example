# Production stack (compose.yml in this folder). Copy to .env.
# Host folder for Postgres, Redis, SeaweedFS and worker scratch data.
DATA_DIR=/DATA/AppData/subtick
# Host ports. Postgres and Redis listen on loopback only, for the recorder (--network host).
POSTGRES_PORT=55432
REDIS_PORT=56379
S3_PORT=8333
API_PORT=53000
WEB_PORT=53080

# openssl rand -hex 24
POSTGRES_PASSWORD=
# SeaweedFS identities; must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY below. Copy
# ../seaweedfs/s3.json, change the keys and point this at it.
S3_CONFIG_FILE=../seaweedfs/s3.json
S3_ACCESS_KEY_ID=subtick
S3_SECRET_ACCESS_KEY=subtick-secret
S3_REGION=us-east-1
S3_BUCKET_DEMOS=demos
S3_BUCKET_CLIPS=clips
# Origin browsers load presigned clip URLs from.
S3_PUBLIC_ENDPOINT=https://subtick-s3.example.com

PUBLIC_URL=https://subtick.example.com
LOG_LEVEL=INFO
# openssl rand -base64 32
BETTER_AUTH_SECRET=
SECRETS_KEY=
STEAM_API_KEY=
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=
