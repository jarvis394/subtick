# Production stack (compose.yml in this folder): paste into Dokploy's Environment tab, which
# writes it to .env next to the compose file.
# Host folder for Postgres, Redis, SeaweedFS and worker scratch data.
DATA_DIR=/DATA/AppData/subtick
# Loopback ports for the recorder (--network host); browsers reach web, /api and S3 via Traefik.
POSTGRES_PORT=55432
REDIS_PORT=56379
S3_PORT=8333
API_PORT=53000
# Hosts Traefik routes: web and /api on PUBLIC_HOST, presigned clip URLs on S3_HOST. The app's
# PUBLIC_URL and S3_PUBLIC_ENDPOINT are https:// these.
PUBLIC_HOST=subtick.example.com
S3_HOST=subtick-s3.example.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
# SeaweedFS identities; must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY below. Copy
# ../seaweedfs/s3.json to the host, change the keys and point this at it (an absolute host path:
# Dokploy can't mount files from its own checkout).
S3_CONFIG_FILE=/DATA/AppData/subtick/s3.json
S3_ACCESS_KEY_ID=subtick
S3_SECRET_ACCESS_KEY=subtick-secret
S3_REGION=us-east-1
S3_BUCKET_DEMOS=demos
S3_BUCKET_CLIPS=clips

LOG_LEVEL=INFO
# openssl rand -base64 32
BETTER_AUTH_SECRET=
SECRETS_KEY=
# Sends email-confirmation links (https://resend.com/api-keys); leave unset locally to log them.
# RESEND_API_KEY=
# MAIL_FROM=subtick <noreply@example.com>
STEAM_API_KEY=
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=
