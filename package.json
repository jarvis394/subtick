{
  "name": "subtick",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "infra:up": "docker compose -f infra/compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/compose.yml --env-file .env down",
    "db:generate": "bun run --filter @subtick/db generate",
    "db:migrate": "bun run --filter @subtick/db migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
